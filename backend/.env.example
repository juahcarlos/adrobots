# URL API Keitaro (базовый, без завершающего слэша)
KEITARO_API_URL=http://localhost:9000/api
# API Token Keitaro — единственное значение, которое нужно заполнить реальным
KEITARO_API_TOKEN=changeme_keitaro_api_key
# Подключение к PostgreSQL
DATABASE_URL=postgresql+asyncpg://adrobot:adrobot@db:5432/adrobot
# ID группы кампаний в Keitaro (FORTESTS)
GROUP_ID=10332
# Уровень логирования приложения
LOG_LEVEL=INFO
